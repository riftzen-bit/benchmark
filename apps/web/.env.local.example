# Supabase project — copy to .env.local and fill in.
# Get these from https://supabase.com/dashboard/project/<ref>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER expose to the client. Used by /api/health and admin scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Used only by `bunx supabase db push` / migrations in CI. Direct DB string.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
