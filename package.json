{
  "name": "benchmark",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter @benchmark/web dev",
    "build": "bun --filter @benchmark/web build",
    "start": "bun --filter @benchmark/web start",
    "lint": "bun --filter @benchmark/web lint",
    "typecheck": "bun --filter @benchmark/web typecheck",
    "test": "bun --filter @benchmark/web test",
    "test:watch": "bun --filter @benchmark/web test:watch",
    "guard": "bun --filter @benchmark/web guard"
  }
}
